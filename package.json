    "express": "latest",
    "framer-motion": "latest",
    "multer": "^2.4.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.0"
