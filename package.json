{
  "name": "maurice-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite --config vite.config.js\"",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --host 0.0.0.0 --config vite.config.js",
